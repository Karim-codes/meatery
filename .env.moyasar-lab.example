# Copy to .env.moyasar-lab.local (ignored). Never use live keys.
MOYASAR_LAB_ENABLED=true
VITE_MOYASAR_LAB_ENABLED=true
VITE_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Use node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# locally to generate a kitchen-only access key. Do not share it publicly.
MOYASAR_LAB_KITCHEN_KEY=
MOYASAR_LAB_ORIGIN=http://localhost:5174
MOYASAR_LAB_API_PORT=8787
# Apple Pay stays disabled until the exact HTTPS hostname is registered.
MOYASAR_LAB_APPLE_PAY_ENABLED=false
MOYASAR_LAB_APPLE_PAY_AMOUNT_HALALAS=25000
